{
  "name": "deckprep",
  "version": "1.4.0-beta.13",
  "description": "Download and verify music from public links and tracklists",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "setup:engine": "node tools/setup-engine.js",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win",
    "build:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/create-icon.ps1",
    "dist:portable": "electron-builder --win portable",
    "setup:desktop": "install-electron",
    "test:desktop": "node tests/electron.e2e.js",
    "test:scale": "node tools/benchmark.js"
  },
  "keywords": [
    "dj",
    "audio-library",
    "id3v2",
    "metadata",
    "music-links",
    "batch-download"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "11.16.1",
    "node-id3": "^0.2.6"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "app.deckprep.desktop",
    "productName": "DeckPrep",
    "electronDist": "node_modules/electron/dist",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/deckprep.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "DeckPrep-Portable-${version}.${ext}",
      "unpackDirName": "DeckPrep-Portable"
    },
    "forceCodeSigning": false,
    "extraResources": [
      {
        "from": "bin/yt-dlp.exe",
        "to": "bin/yt-dlp.exe"
      }
    ],
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "docs/licenses/**/*"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
